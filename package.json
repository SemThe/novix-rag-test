{
  "name": "novix-rag-test",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype RAG pipeline for Novix backoffice: ingest sources, retrieve grounded fragments, and generate reviewable content opdrachten.",
  "type": "module",
  "scripts": {
    "ingest": "tsx src/cli.ts ingest",
    "search": "tsx src/cli.ts search",
    "generate": "tsx src/cli.ts generate",
    "review": "tsx src/cli.ts review",
    "stats": "tsx src/cli.ts stats",
    "server": "tsx watch src/server/index.ts",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run server\" \"npm run dev --prefix web\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@huggingface/transformers": "^4.3.0",
    "commander": "^12.1.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.7.5",
    "concurrently": "^10.0.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
