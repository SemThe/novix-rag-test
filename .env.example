# Welke AI-provider gebruikt de generatiestap: "claude" (Anthropic API) of "ollama" (lokaal, gratis)
GENERATION_PROVIDER=claude

# Verplicht als GENERATION_PROVIDER=claude (haal op via https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optioneel: overschrijf het standaardmodel
CLAUDE_MODEL=claude-sonnet-5

# Alleen relevant als GENERATION_PROVIDER=ollama. Vereist dat Ollama lokaal draait
# (https://ollama.com) met dit model gepulld, bv. `ollama pull qwen2.5:7b-instruct`.
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434
